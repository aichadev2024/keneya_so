# Kènèya Sô — variables d'environnement
# Copier ce fichier vers .env et adapter les valeurs. Ne jamais versionner .env.

# --- Général ---
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=changez-moi-en-production-avec-une-cle-longue-et-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de données ---
# Cible du CDC (section 8) : PostgreSQL.
#   DATABASE_URL=postgres://keneya:motdepasse@localhost:5432/keneya_so
# Repli développement rapide sans serveur PostgreSQL installé :
DATABASE_URL=sqlite:///db.sqlite3

# --- Internationalisation ---
DJANGO_LANGUAGE_CODE=fr
DJANGO_TIME_ZONE=Africa/Bamako

# --- Sécurité (mettre à True derrière HTTPS en production, CDC 7.1) ---
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# Nombre de reverse-proxies de confiance devant l'application (0 par défaut :
# l'en-tête X-Forwarded-For n'est jamais pris en compte pour le journal
# d'audit, car falsifiable par n'importe quel client sans proxy connu).
# Mettre à 1 en production derrière Render/Railway (un seul maillon).
DJANGO_PROXIES_DE_CONFIANCE=0

# --- CORS (utile si un client d'API distinct est ajouté plus tard) ---
DJANGO_CORS_ALLOWED_ORIGINS=
